{
  "imports": [],
  "mcpServers": {
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "mcp/sonarqube"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "sipgate"
      }
    },
    "sg42": {
      "type": "http",
      "url": "https://sg42.tools.sipgate.net/mcp",
      "auth": "oauth",
      "oauth": {
        "scope": "openid"
      }
    },
    "grafana": {
      "type": "stdio",
      "command": "/Users/beruflich/go/bin/mcp-grafana",
      "args": [],
      "env": {
        "GRAFANA_URL": "https://grafana.sipgate.cloud",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "sg32": {
      "type": "http",
      "url": "https://sg32.tools.dev.sipgate.net/mcp",
      "auth": "oauth",
      "oauth": {
        "scope": "openid"
      }
    },
    "jira": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "auth": "oauth"
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/",
      "auth": "oauth"
    }
  }
}
